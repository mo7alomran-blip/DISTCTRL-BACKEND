# DistOps backend — إعدادات البيئة (انسخ هذا الملف إلى .env واملأ القيم الحقيقية، لا ترفع .env نفسه لأي مكان)

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=distops
DB_PASSWORD=
DB_NAME=distops

# JWT (يحل محل Supabase Auth JWT) — سلسلة عشوائية طويلة، مختلفة بين التجريبي والرئيسي
JWT_SECRET=

# منفذ السيرفر
PORT=3001

# مفاتيح VAPID لإشعارات Web Push (نفس القيم الحالية بكل بيئة — لا تتغير عن Supabase)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:mo7.alomran@gmail.com

# مفتاح Resend لإرسال التقارير بالبريد (نفس القيمة الحالية بمشروع Supabase)
RESEND_API_KEY=

# سر مشترك يتحقق منه cron.js لأي استدعاء داخلي (يحل محل x-cron-secret بين pg_cron والدوال)
CRON_SECRET=

# مجلد رفع الملفات المحلي (يحل محل Supabase Storage buckets)
UPLOADS_DIR=./uploads

# نطاق الفرونت المسموح له بالاتصال (CORS) — نفس دومين Vercel لهذه البيئة
FRONTEND_ORIGIN=https://my-warehouse-kappa.vercel.app
